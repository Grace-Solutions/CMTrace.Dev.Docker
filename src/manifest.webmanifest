{
  "name": "CMTrace Web",
  "short_name": "CMTrace",
  "description": "A fast, 100% client-side log viewer for SCCM/ConfigMgr, Intune, and plain text logs. CMTrace in your browser.",
  "start_url": "app.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#39A751",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "app.html",
      "accept": {
        "text/plain": [
          ".log",
          ".lo_",
          ".txt"
        ]
      }
    }
  ]
}
